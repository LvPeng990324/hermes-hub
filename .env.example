# ---------- HermesHub 平台配置 ----------
# 管理端登录密码（必填，无用户系统，仅此一个密码）
ADMIN_PASSWORD=change-me

# HTTP 监听端口
PORT=8080

# JWT 签名密钥（可选，缺省时由 ADMIN_PASSWORD 派生）
# JWT_SECRET=

# SQLite 数据库文件路径
DB_PATH=./data/hermeshub.db

# 共享文件根目录：每个项目在其中独占一个子目录，Hermes 可自由读写
SHARED_FILES_ROOT=./data/shared

# 平台对外可达地址：会写进下发给 Hermes 的指令上下文，供其回调工具 API
# 若 Hermes 在其他机器，请填平台机器的内网/公网地址
PLATFORM_PUBLIC_URL=http://localhost:8080

# 指令上下文携带的最近消息条数
RECENT_MESSAGES_LIMIT=20

# 派发任务超时（分钟），超时未完成标记为 timeout
DISPATCH_TIMEOUT_MINUTES=30
